{
	"version": 3,
	"configurePresets": [
		{
			"name": "environment-base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/win32/${presetName}",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl.exe",
				"CMAKE_CXX_COMPILER": "cl.exe"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		}
	]
}