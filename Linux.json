{
	"version": 3,
	"configurePresets": [
		{
			"name": "environment-base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/linux/${presetName}",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		}
	]
}